{
  "name": "explainers",
  "version": "0.1.0",
  "private": true,
  "description": "Scrollytelling explainers: a generic engine (engine/), and explainers by topic (topics/), starting with Couchbase full-text search internals",
  "license": "Apache-2.0",
  "author": "Couchbase, Inc.",
  "type": "module",
  "scripts": {
    "build": "node engine/build/build.mjs",
    "snippets": "node engine/build/snippets.mjs",
    "dev": "node engine/build/build.mjs --watch",
    "test": "node --test \"engine/test/*.test.mjs\" \"topics/*/*/test/*.test.mjs\"",
    "test:e2e": "node --test \"engine/test-e2e/*.test.mjs\" \"topics/*/*/test-e2e/*.test.mjs\"",
    "golden": "node engine/build/golden.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "highlight.js": "11.9.0",
    "js-yaml": "4.3.2",
    "marked": "12.0.2",
    "playwright-core": "1.56.1"
  },
  "engines": {
    "node": ">=20"
  }
}
